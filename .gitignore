# Godot-specific ignores
.import/
export.cfg
export_presets.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/

# System/tool-specific
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.code-workspace
AGENTS.md
TODO.md
.agents/

# Build artifacts
*.o
*.pyc
*.class
*.exe
*.dll
*.so
*.dylib

# Dependencies (except submodules)
dependencies/*
!dependencies/_Lib/

# Generated test dependencies and results (never part of the runtime mod).
tests/addons/
tests/.cache/
tests/results/
tests/*.log
tests/logs/
tests/__pycache__/
